# ============================================================
# Rabi's Saving Hub — environment
#
# Copy to `.env.local` for development and paste the same keys into
# Vercel → Settings → Environment Variables for production.
#
# Verify at any time:  npm run env:check
# Live status:         /api/health   (names only, never values)
# Full guide:          docs/INTEGRATIONS.md
# ============================================================

# ============================================================
# 1. FIREBASE — REQUIRED (auth + Firestore)
# Firebase console → Project settings → Your apps → Web app config
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Same public web key, read server-side to verify ID tokens via Identity
# Toolkit. Not a secret (it ships in the bundle anyway), but the API routes
# need it in the server environment too.
FIREBASE_API_KEY=""

# Comma separated admin emails — the fallback admin check and the recipient of
# "new registration" alerts. Custom claims (`admin: true`) remain primary.
NEXT_PUBLIC_ADMIN_EMAIL="rabisavinghub@gmail.com,moneyace914@gmail.com"
ADMIN_EMAILS="rabisavinghub@gmail.com,moneyace914@gmail.com"

# ============================================================
# 2. CLOUDINARY — REQUIRED for KYC uploads
# Cloudinary dashboard → Product environment credentials
# All three values must come from the SAME account: a key from one cloud and a
# secret from another produce "Invalid Signature" on every upload.
# The browser never posts to Cloudinary. /api/upload signs server-side, and it
# accepts the signup flow's uploads before the account exists, rate limited per
# address and capped at 4 MB after byte sniffing.
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# 3. RESEND — transactional email
# resend.com → API Keys. Falls back to Gmail/Brevo SMTP if unset.
#
# MAIL_MODE is the switch:
#   log  (default)  nothing leaves the server, the message is printed to the
#                   server console and marked "logged" on the member record.
#   live            Resend first, then Gmail SMTP, then Brevo SMTP.
#
# Keep it on "log" until rabissavinghub.com is registered, added to Resend and
# its DKIM, SPF and DMARC records are verified. EMAIL_FROM must use that exact
# domain: Resend only delivers a resend.dev sender to the account owner.
# ============================================================
MAIL_MODE="log"
RESEND_API_KEY=""
EMAIL_FROM="Rabi's Saving Hub <noreply@rabissavinghub.com>"
EMAIL_REPLY_TO="rabisavinghub@gmail.com"

EMAIL_USER="rabisavinghub@gmail.com"
EMAIL_PASSWORD=""

BACKUP_EMAIL_USER=""
BACKUP_EMAIL_PASSWORD=""

# ============================================================
# 4. KYC SCREENING — strategy A
#
# There is no third-party identity provider and no separate screening service.
# The checks that run are in this repository, on the server, with no key:
#
#   card MRZ + ICAO check digits   kyc-deterministic.ts (Tesseract, vendored)
#   card number vs MRZ             matchTypedPin
#   card front printing markers    cardTemplateMarkers
#   selfie has a human face        kyc-face-server.ts (tfjs-wasm, vendored)
#   selfie has eyes                faceLandmark68, same runtime
#   name / DOB / sex vs the card   kyc-identity-check.ts
#
# Everything that cannot be decided is routed to Rabi. Nothing here needs an
# API key, which is why signup works with no third-party budget.
# ============================================================

# ============================================================
# 5. UPSTASH REDIS — rate limiting (free tier)
# console.upstash.com → database → REST API
# Without it, limits live in memory and leak across serverless instances.
# ============================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# 5. POSTHOG — product analytics (free tier)
# Loads ONLY after cookie consent. Leaving it empty ships zero third-party JS.
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ============================================================
# 6. SENTRY — error tracking (free tier)
# Server-side only; the client relays through /api/errors (0 kB SDK).
# ============================================================
SENTRY_DSN=""

# ============================================================
# 7. APP / SEO
# ============================================================
NEXT_PUBLIC_APP_URL="https://rabis-saving-hub.vercel.app"

# The live domain today is the Vercel one. Change this single value when Rabi
# buys her own domain and every canonical, sitemap entry and social card
# follows.
NEXT_PUBLIC_SITE_URL="https://rabis-saving-hub.vercel.app"

# Google Search Console → URL prefix property → HTML tag → content value only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ============================================================
# 8. VISION SCREENING (server-only; never NEXT_PUBLIC_)
#
# One or more free-tier API keys. They are tried in this order — Gemini, then
# Groq, then OpenRouter — and the first usable answer decides the application.
# All three may be set; each covers the others' daily quota.
#
#   GEMINI     https://aistudio.google.com/apikey          (free tier)
#   GROQ       https://console.groq.com/keys               (free tier)
#   OPENROUTER https://openrouter.ai/keys                  (free models)
#
# Leave every key empty and KYC still works: the application is accepted and
# queued for Rabi with "no AI provider configured". It is never auto-approved.
#
# The model variables are comma-separated fallback lists, not single names.
# Providers retire free model IDs without warning; a retired ID yields a 404
# which is skipped in favour of the next entry. Check the provider's model page
# before changing these, and note that Groq has previously dropped its
# vision-capable models from the free tier entirely.
# ============================================================
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash"
GROQ_API_KEY=""
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct"
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL="google/gemma-4-31b-it:free,google/gemma-3-27b-it:free,qwen/qwen2.5-vl-72b-instruct:free"
# Hard ceiling on one screening attempt, in milliseconds. A slow provider is
# skipped rather than left to hold the signup request open.
KYC_VISION_TIMEOUT_MS="20000"

# ============================================================
# 9. OPTIONAL KYC SCREENING (server-only; never NEXT_PUBLIC_)
# Hosted FastAPI URL, e.g. your Render Web Service URL. If absent/unavailable,
# signup continues pending manual review. Share a random 32+ byte secret only
# with this backend and the Vercel server environment.
# ============================================================
KYC_SCREENING_URL=""
KYC_SCREENING_SHARED_SECRET=""

# ============================================================
# 10. SERVICE ACCOUNT — server/CLI only, NEVER expose to the browser
# Used by `npm run admin:setup` to grant the admin custom claim, and by the
# notify routes to read member records and record delivery state.
# Paste the downloaded JSON as a single line, or base64-encode it.
# ============================================================
FIREBASE_SERVICE_ACCOUNT_KEY=""
