# ============================================================
# FIREBASE (REQUIRED — the app runs in read-only "not configured"
# mode until these are set)
# Firebase Console → Project settings → Your apps → Web app config
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Comma separated admin emails. Used for the admin-panel email fallback and as
# the recipient of "new registration" alerts. Custom Claims (admin: true) are
# still the primary way to grant admin access.
NEXT_PUBLIC_ADMIN_EMAIL="rabisavinghub@gmail.com,moneyace914@gmail.com"

# ============================================================
# CLOUDINARY (REQUIRED for Ghana Card / selfie / liveness uploads)
# Create an UNSIGNED upload preset named "rabi-user-docs".
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# EMAIL (OPTIONAL — any one provider is enough)
# Provider order: Resend → Gmail SMTP → Brevo SMTP
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="Rabi's Saving Hub <noreply@rabissavinghub.com>"

EMAIL_USER="rabisavinghub@gmail.com"
EMAIL_PASSWORD=""

BACKUP_EMAIL_USER=""
BACKUP_EMAIL_PASSWORD=""

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="https://rabissavinghub.com"

# ============================================================
# ADMIN SCRIPTS ONLY (never expose to the browser)
# Used by scripts/admin-setup.mjs to grant the `admin` custom claim.
# Paste the service-account JSON as a single line.
# ============================================================
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ============================================================
# SITE / SEO (REQUIRED for correct canonicals + sitemap)
# The live domain today is the Vercel one. When Rabi buys her own
# domain, change this single value and every canonical, sitemap
# entry and social card follows.
# ============================================================
NEXT_PUBLIC_SITE_URL="https://rabis-hub.vercel.app"

# Google Search Console → "URL prefix" property → HTML tag method.
# Paste ONLY the content value, e.g. "abc123..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ============================================================
# ANALYTICS (OPTIONAL — PostHog, free tier)
# Session replay + funnels. Loads ONLY after cookie consent.
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ============================================================
# ERROR TRACKING (OPTIONAL — Sentry, free tier)
# Server-side only. Client errors are relayed through /api/errors.
# ============================================================
SENTRY_DSN=""

# ============================================================
# RATE LIMITING (OPTIONAL — Upstash Redis, free tier)
# Without these the app falls back to an in-memory limiter.
# ============================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# OWNER / ADMIN (server-side)
# Comma separated. Used by the email policy (who a member may notify) and by the
# API routes to recognise the owner account. Keep this server-only.
# ============================================================
ADMIN_EMAILS="rabisavinghub@gmail.com,moneyace914@gmail.com"

# ============================================================
# FIREBASE API KEY (server-side token verification)
# The same public web API key; the server uses it to validate ID tokens through
# Google Identity Toolkit before sending mail or accepting an upload.
# ============================================================
FIREBASE_API_KEY=""

# ============================================================
# AUTH — CLERK (reserved, not active)
# Firebase Auth is the live provider for this release. These variables are here
# so the migration in docs/CLERK_MIGRATION.md can be switched on without a
# scramble. Leaving them empty changes nothing.
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ============================================================
# CLOUDINARY SIGNED UPLOADS (required for /api/upload)
# The API key + secret sign every member upload server-side. Without the secret,
# KYC uploads fail closed (the browser cannot upload directly any more).
# ============================================================
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
