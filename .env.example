# ============================================================
# SUPABASE (REQUIRED — the app runs in read-only "not configured"
# mode until these are set)
# Supabase dashboard → Project settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Used by the registration rollback route and by
# `npm run admin:setup`. NEVER prefix this with NEXT_PUBLIC_ and never
# commit the real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Comma separated admin emails. Grants the admin panel to these accounts and
# receives "new registration" alerts. `profiles.is_admin` is the primary source
# of truth once `npm run admin:setup` has run.
NEXT_PUBLIC_ADMIN_EMAIL="rabisavinghub@gmail.com,moneyace914@gmail.com"

# ============================================================
# CLOUDINARY (OPTIONAL — only if you move KYC uploads to Cloudinary)
# Create an UNSIGNED upload preset named "rabi-user-docs".
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# EMAIL (OPTIONAL — any one provider is enough)
# Provider order: Resend → Gmail SMTP → Brevo SMTP
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="Rabi's Saving Hub <noreply@rabissavinghub.com>"

EMAIL_USER="rabisavinghub@gmail.com"
EMAIL_PASSWORD=""

BACKUP_EMAIL_USER=""
BACKUP_EMAIL_PASSWORD=""

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="https://rabissavinghub.com"
