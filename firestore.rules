rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = the `admin` custom claim (set by scripts/admin-setup.mjs).
    // Owner addresses are honoured as a fallback, but only for *verified*
    // addresses, so an unverified account can never inherit owner powers.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() in ['rabisavinghub@gmail.com', 'moneyace914@gmail.com']
        )
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // Members
    // ---------------------------------------------------------------
    match /users/{uid} {
      // A member sees exactly one record: their own. Nobody can enumerate or
      // read another person's card number, address, GPS pin or documents.
      allow read: if isSelf(uid) || isAdmin();

      // A member may create exactly one profile, for their own address, always
      // pending. Required fields and sane lengths stop junk/oversized documents.
      allow create: if isSelf(uid)
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'plan', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.plan is string
        && request.resource.data.plan.size() <= 40
        && (!('location' in request.resource.data) || (
             request.resource.data.location is string
             && request.resource.data.location.size() <= 120
           ))
        && (!('ghanaCardNumber' in request.resource.data) || (
             request.resource.data.ghanaCardNumber is string
             && request.resource.data.ghanaCardNumber.size() <= 24
           ))
        // Bookkeeping that only Rabi or the server may produce must never
        // arrive pre-filled. A forged `contributions` list would make a brand
        // new account look paid up, and a pre-set `adminAlertAt` would hide the
        // signup from her alert queue, so both are refused outright.
        && (!('contributions' in request.resource.data)
            || request.resource.data.contributions.size() == 0)
        && (!('whatsappLink' in request.resource.data)
            || request.resource.data.whatsappLink == '')
        && !('adminAlertAt' in request.resource.data)
        && !('decisionEmailAt' in request.resource.data);

      // A member may edit their own contact details, and may upload identity
      // documents ONLY while the application is still pending.
      //
      // This closes the identity swap: previously an approved member could
      // replace the Ghana Card photos, the selfie and the card number after
      // approval, so the evidence behind an approval was whatever the account
      // said it was today. Once a decision is recorded, the identity fields are
      // frozen. A rejected member who wants to resubmit contacts Rabi on
      // WhatsApp, she resets the account to pending, and the upload opens again.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'location', 'plan', 'plans',
          'ghanaCardNumber', 'ghanaCardValid', 'ghanaCardFront', 'ghanaCardBack',
          'passportPhoto', 'faceScanVideo', 'ghanaCardOcrResult',
          'gpsLat', 'gpsLng', 'gpsAddress',
          'locationSource', 'locationAccuracy', 'locationReview',
          'kycReviewReason',
          'termsAccepted', 'termsAcceptedAt'
        ])
        && (
          resource.data.status == 'pending'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ghanaCardNumber', 'ghanaCardValid',
            'ghanaCardFront', 'ghanaCardBack',
            'passportPhoto', 'faceScanVideo', 'ghanaCardOcrResult',
            'gpsLat', 'gpsLng', 'gpsAddress',
            'locationSource', 'locationAccuracy', 'locationReview', 'kycReviewReason'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Settings (custom plans are public, WhatsApp links are admin-only)
    // ---------------------------------------------------------------
    match /settings/customPlans {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Announcements
    // ---------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Testimonials / reviews
    // ---------------------------------------------------------------
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 600;
      allow update, delete: if isAdmin();
    }

    // Payments, Susu rounds and payment reports were removed with the MVP
    // scope change: Rabi collects and runs the rounds on WhatsApp. The
    // collections are gone, so no rules remain for them.
  }
}
