rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Privilege comes only from a server-assigned custom claim. Email addresses
    // are identity attributes, not authorization credentials.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // Members
    // ---------------------------------------------------------------
    match /users/{uid} {
      // A member sees exactly one record: their own. Nobody can enumerate or
      // read another person's card number, address, GPS pin or documents.
      allow read: if isSelf(uid) || isAdmin();

      // Applicant creation and KYC evidence submission go through trusted
      // server routes. The Admin SDK bypasses these rules; a browser cannot
      // create a profile carrying evidence, decisions, or audit fields.
      allow create: if false;

      // Applicant updates are limited to ordinary contact preferences. KYC
      // evidence is immutable after the server accepts the submission; only
      // server routes may change review or decision state.
      allow update: if (
        isSelf(uid)
        && request.resource.data.status == resource.data.status
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'location', 'plan', 'plans'
        ])
      ) || (
        isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'ghanaCardNumber', 'ghanaCardValid', 'ghanaCardFront',
          'ghanaCardBack', 'passportPhoto', 'faceScanVideo', 'ghanaCardOcrResult',
          'kycReviewStatus', 'kycReviewReason', 'kycSubmittedAt', 'kycPolicyVersion',
          // The AI's answers are evidence, not an opinion an admin may edit.
          // If a reviewer could rewrite them, the audit trail for "why was this
          // refused or held" would be worth nothing.
          'kycScreeningChecks', 'kycScreeningModelVersion',
          'evidenceHashes', 'reviewerUid', 'reviewedAt', 'approvalEligibility',
          // The fraud evidence added with the two-signal rule. Same reasoning as
          // the AI's answers above: if a reviewer could edit the reason an
          // application was refused, the audit trail would be worth nothing.
          'kycPerceptualHashes', 'kycRiskDecision', 'kycRiskSignals',
          'kycRiskSentence', 'kycCardLock', 'kycScreenPhoto', 'kycDuplicateOf',
          'kycSelfieCaptureMode',
          'gpsLat', 'gpsLng', 'gpsAddress', 'locationSource', 'locationAccuracy', 'locationReview',
          'adminAlertAt', 'adminAlertProvider', 'decisionEmailAt', 'decisionEmailFor',
          'decisionEmailStatus', 'decisionEmailProvider'
        ])
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // One Ghana Card, one account
    // ---------------------------------------------------------------
    //
    // A lock document per card, keyed on sha256(mrz document number). It is
    // written only inside the signup transaction, so no client can create one,
    // release one, or move a card from one account to another.
    //
    // Reads are admin-only, and that is a deliberate restriction rather than an
    // oversight: the lock records which account holds a card, so allowing a
    // member to read it would let anyone holding a stolen card number discover
    // the victim's uid. Rabi needs the link; the applicant does not.
    match /cardLocks/{lockId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Every attempt to reuse a claimed card, for Rabi's queue. Written by the
    // server route from inside the error path, never by a browser.
    match /cardLockAttempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Settings (custom plans are public, WhatsApp links are admin-only)
    // ---------------------------------------------------------------
    match /settings/customPlans {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Announcements
    // ---------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Testimonials / reviews
    // ---------------------------------------------------------------
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 600);
      allow update, delete: if isAdmin();
    }

    // Payments, Susu rounds and payment reports were removed with the MVP
    // scope change: Rabi collects and runs the rounds on WhatsApp. The
    // collections are gone, so no rules remain for them.
  }
}
